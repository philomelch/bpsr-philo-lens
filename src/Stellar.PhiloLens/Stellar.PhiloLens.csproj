<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net6.0 is dictated by the BepInEx 6 IL2CPP host runtime. Do not "upgrade" it. -->
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>Stellar.PhiloLens</RootNamespace>
    <AssemblyName>Stellar.PhiloLens</AssemblyName>
    <!-- The release version. A push to main publishes a release when this changes (and CHANGELOG.md
         has a matching "## [x.y.z] - YYYY-MM-DD" section). 0.0.0 means "not released yet". -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version pinned in Directory.Packages.props. Plugins reference ONLY the Stellar SDK. -->
    <PackageReference Include="Stellar.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The LogicalName is required: the framework discovers catalogs as "Lang.<code>.json". -->
    <EmbeddedResource Include="Lang/*.json" LogicalName="Lang.%(Filename)%(Extension)" />
    <!-- Generated by tools/icons/generate_lens_icon.py; loaded by UI/EmbeddedIcons.cs. -->
    <EmbeddedResource Include="Icons/*.png" LogicalName="Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stellar.PhiloLens.Tests" />
  </ItemGroup>
</Project>
