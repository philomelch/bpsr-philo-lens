root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,props,csproj,yml,yaml}]
indent_size = 2

[*.cs]
# File-scoped namespaces are a hard rule (enforced at build via EnforceCodeStyleInBuild).
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
